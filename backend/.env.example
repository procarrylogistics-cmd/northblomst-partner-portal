# === Local ===
MONGODB_URI=mongodb://localhost:27017/northblomst
PORT=5000
JWT_SECRET=supersecretjwtkey

# === Producție (Render) ===
# NODE_ENV=production
# MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/northblomst
# JWT_SECRET=your-secret-min-32-chars
# CORS_ORIGIN=https://your-app.vercel.app

# Partner finance (Stripe buffer + platform cut)
# FIXED_SHIPPING_DKK=69
# STRIPE_FEE_PERCENT=2.9
# STRIPE_FEE_FIXED=1.8
# PLATFORM_CUT_PERCENT=20

# Shopify OAuth (required for install flow)
SHOPIFY_API_KEY=your_shopify_api_key
SHOPIFY_API_SECRET=your_shopify_api_secret
SHOPIFY_SCOPES=read_orders,read_products,write_orders
SHOPIFY_APP_URL=https://northblomst-partner-portal-1.onrender.com
# Public shop URL for product links in orders
SHOPIFY_STOREFRONT_URL=https://northblomst.dk
# Store handle from admin URL (admin.shopify.com/store/northbloom/...)
SHOPIFY_ADMIN_STORE_HANDLE=northbloom
# Webhook Signing Secret (Shopify Admin → Settings → Notifications → Webhooks)
# Do NOT use SHOPIFY_API_SECRET for webhooks
SHOPIFY_WEBHOOK_SECRET=your_webhook_signing_secret
# Set to "true" to log payload summary (keys/structure only, no PII) for add-on debugging
# DEBUG_WEBHOOK_PAYLOAD=true
# Set to "true" to log sample imageUrl when enriching orders (webhook + sync)
# DEBUG_IMAGE_ENRICH=true
# URL public unde Shopify trimite webhooks (ex: ngrok sau producție)
SHOPIFY_WEBHOOK_BASE_URL=https://your-ngrok-url.ngrok-free.app

# Proxy Shopify CLI – port fix 3456 (pornește cu --use-localhost --localhost-port=3456)
SHOPIFY_PROXY_URL=http://localhost:3456

ZAPIER_TRACKPOD_WEBHOOK_URL=https://hooks.zapier.com/hooks/catch/xxxxxxxx/xxxxxxxx

# procarry-track direct integration (preferred over Zapier for delivery)
# Trigger: order status → ready (Klar til levering). Zapier still fires on assign if configured.
PROCARRY_TRACK_API_URL=https://procarry-track.vercel.app
PROCARRY_TRACK_API_KEY=
# Must match NORTHBLOMST_WEBHOOK_SECRET on Track; inbound POST /api/webhooks/procarry-track
PROCARRY_TRACK_WEBHOOK_SECRET=

# Nodemailer + Gmail (use App Password from Google account)
EMAIL_USER=northblomst.noreply@gmail.com
EMAIL_PASS=jxcullxlpnbhajaz
EMAIL_FROM="Northblomst <northblomst.noreply@gmail.com>"
PORTAL_URL=http://localhost:3000
ADMIN_EMAIL=office@northblomst.dk

# Optional: switch to SendGrid later
# SENDGRID_API_KEY=your_sendgrid_api_key

TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+4512345678

